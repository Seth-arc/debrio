{
  "name": "debrio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:guards": "node scripts/check-failure.mjs",
    "test:browser": "playwright test",
    "db:start": "docker compose up -d --wait db",
    "db:reset": "docker compose down --volumes && docker compose up -d --wait db",
    "test:db": "docker compose run --rm tests",
    "db:stop": "docker compose down --volumes",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "clean": "node scripts/clean.mjs",
    "sbom": "npm sbom --include=dev --sbom-format=cyclonedx",
    "security:dependencies": "audit-ci --config audit-ci.json",
    "probe:local": "node scripts/run-media-probe.mjs",
    "test:media": "node scripts/run-media-probe.mjs --test",
    "probe:agora": "node scripts/run-agora-probe.mjs"
  },
  "dependencies": {
    "livekit-client": "2.24.1",
    "livekit-server-sdk": "2.20.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "agora-rtc-sdk-ng": "4.24.10",
    "agora-token": "2.0.7",
    "audit-ci": "7.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-security": "4.2.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "type": "module"
}

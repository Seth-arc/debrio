# The application shell needs no provider credentials.
# Optional: disable Next.js anonymous developer telemetry.
NEXT_TELEMETRY_DISABLED=1
# Never put hosted Supabase, LiveKit, mail or payment secrets in NEXT_PUBLIC_*.
# Add provider variables only with the feature that validates and consumes them.
# Optional synthetic probe only; disabled by default and always disabled on Vercel.
# npm run probe:local supplies its own disposable local values and private fixtures.
MEDIA_PROBE_ENABLED=0
# MEDIA_PROBE_ORIGIN=http://127.0.0.1:3101
# LIVEKIT_URL=wss://your-isolated-test-project.livekit.cloud
# LIVEKIT_API_KEY=server-only-key
# LIVEKIT_API_SECRET=server-only-secret
# Hosted runs require verified account allowance and recording-disabled settings first.
# Optional local Agora qualification CLI only. Never expose the certificate to browsers.
# AGORA_APP_ID=your-isolated-project-app-id
# AGORA_APP_CERTIFICATE=your-primary-certificate
# AGORA_PROBE_CONFIRMED is supplied explicitly by the operator, not enabled here.
